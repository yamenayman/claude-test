# --- Retrieval -------------------------------------------------------------
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_CLASS=LegalChunk
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=5
RAG_PROMPT_TOP_N=3
CHUNK_TEXT_LIMIT=900

# --- Knowledge graph --------------------------------------------------------
# Additive rerank boost per legal concept shared between the question and a chunk.
KG_BOOST_PER_CONCEPT=0.04

# --- LLM provider -----------------------------------------------------------
# ollama (local, default) | openai (any OpenAI-compatible API) | anthropic (Claude API)
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096

# Local Ollama (default provider)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

# OpenAI-compatible API (OpenAI, Groq, OpenRouter, DeepSeek, local vLLM, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Web --------------------------------------------------------------------
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8001
WEB_ORIGIN=http://localhost:3001
